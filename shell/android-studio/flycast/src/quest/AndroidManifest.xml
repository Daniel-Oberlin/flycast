<?xml version="1.0" encoding="utf-8"?>
<!-- HydroThunder4Quest: Meta Quest additions, merged over src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
    </queries>

    <application android:label="Hydro Thunder VR" tools:replace="android:label">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />

        <!-- launch immersive: the VR launcher category must be on the activity itself -->
        <activity
            android:name="com.flycast.emulator.NativeGLActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            tools:replace="android:screenOrientation">
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
        <activity-alias android:name="com.flycast.emulator.MainActivity" tools:node="remove" />
    </application>
</manifest>
